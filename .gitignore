# ==============================================
# 1. Python 基础运行缓存/编译文件（必选）
# ==============================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
# Conda 虚拟环境
conda_env/
.conda/
# Pipenv/Poetry 缓存
Pipfile.lock
poetry.lock
.venv/

# ==============================================
# 2. 编辑器/IDE 配置（适配 PyCharm + VS Code）
# ==============================================
.idea/
.vscode/
*.swp
*.swo
*.ipr
*.iws
*.iml
# Jupyter Notebook 检查点
.ipynb_checkpoints/
*_checkpoint.ipynb

# ==============================================
# 3. 机器学习项目特有的大文件/资源
# ==============================================
# 压缩包（忽略，避免仓库体积过大）
*.zip
*.rar
*.7z
*.tar.gz
*.tar

# 数据集文件夹（按需选择是否忽略）
# data/
# datasets/
# dataset/
# Datasets/
# raw_data/
# processed_data/

# 模型权重/缓存（所有框架的模型文件）
*.pth
*.pt
*.h5
*.ckpt
*.onnx
*.pb
*.saved_model/
*.ckpt.index
*.ckpt.data-00000-of-00001

# 图片缓存/临时输出图片（保留原始数据图片）
# 注意：building/、mountain/等数据图片需手动添加到.gitignore例外
output/*.jpg
output/*.png
output/*.jpeg
output/*.gif
output/*.svg
output/*.bmp
results/*.jpg
results/*.png
temp_images/

# ==============================================
# 4. 日志/临时文件/输出（机器学习实验专属）
# ==============================================
*.log
*.tmp
*.temp
output/
results/
runs/  # TensorBoard 日志
lightning_logs/  # PyTorch Lightning 日志
wandb/  # Weights & Biases 缓存
mlruns/  # MLflow 日志

# 训练过程临时文件（可选）
# *.npy
# *.npz
# *.pickle
# *.pkl

# 输出的预测结果
predictions/
submissions/

# ==============================================
# 5. 系统/其他无关文件
# ==============================================
.DS_Store  # Mac 系统文件
Thumbs.db  # Windows 系统文件
*.bak
*.old
# 敏感文件（密钥/配置）
.env
.env.*
*.secret
*.key
token.txt
config_dev.py  # 开发环境配置（含密码/路径）

# ==============================================
# 6. 特殊说明（重要！）
# ==============================================
# 以下文件已存在于项目中，不会被此 gitignore 影响：
# - 所有.pdf 文件（教材和实验指导书，需要保留）
# - building/、mountain/中的图片（实验数据，需要保留）
# - 实验 02-菜市场.jpg（实验数据，需要保留）
# 如需忽略特定数据文件夹，请在本地添加白名单规则
